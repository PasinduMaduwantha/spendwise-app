rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Private per-user financial ledger, budgets, accounts, categories, recurring rules
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Opt-in anonymized price & rating observations for future community comparison.
    // Users can read aggregated community observations once signed in,
    // and only create/update/delete observations they authored.
    match /community_observations/{obsId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.normalizedUnitPrice > 0
        && request.resource.data.qualityRating >= 1
        && request.resource.data.qualityRating <= 5
        && request.resource.data.experienceRating >= 1
        && request.resource.data.experienceRating <= 5;
      allow update, delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
